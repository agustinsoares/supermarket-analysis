# Supabase (Project settings > API). Service role key: SOLO servidor, nunca en el navegador.
SUPABASE_URL=https://pcobacltecgcexjdygpv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Kassalapp (https://kassal.app > API)
KASSAL_TOKEN=

# Clave de acceso a la web (inventa una larga y aleatoria: `openssl rand -base64 32`)
SYNC_SECRET=

# Lectura de folletos con IA. Basta con UNA de las dos claves (si hay las dos, se usa Gemini; LLM_PROVIDER lo fuerza).
# Gemini: https://aistudio.google.com/apikey  (usa una cuenta Google personal; Workspace Gemini Pro NO incluye API)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Claude: https://console.anthropic.com > API keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# gemini | anthropic (opcional)
LLM_PROVIDER=
